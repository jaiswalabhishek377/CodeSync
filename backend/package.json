    "piston:up": "docker compose -f piston/docker-compose.yaml up -d && echo \"✅ Piston started on port 2000. Check: curl http://localhost:2000/api/v2/languages\"",
    "piston:down": "docker compose -f piston/docker-compose.yaml down",
    "piston:logs": "docker logs piston_api -f",
    "piston:health": "curl -s http://localhost:2000/api/v2/languages | head -c 100",
    "health": "curl -s http://localhost:5000/api/health | node -e \"console.log(JSON.stringify(JSON.parse(require('fs').readFileSync(0, 'utf-8')), null, 2))\"",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push"
